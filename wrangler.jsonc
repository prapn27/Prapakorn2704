{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slip-budget",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slip-budget",
      // ตัวแทน — workflow (.github/workflows/deploy.yml) หา/สร้าง D1 แล้วแทนค่านี้ให้เองตอน deploy
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Firebase project id (ใช้ตรวจ issuer/audience ของ ID token)
    "FIREBASE_PROJECT_ID": "slip-budget"
  },
  // ลบ tombstone ที่เก่ากว่า 90 วัน ตี 2 เวลาไทย (19:17 UTC)
  "triggers": { "crons": ["17 19 * * *"] }
}
